{
  "name": "amethyst-companion",
  "version": "0.1.0",
  "private": false,
  "description": "Standalone local companion for Amethyst. Runs allowlisted REA workflows on explicitly approved local targets and submits evidence.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "amethyst-companion": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANPAN27/Amethyst.git",
    "directory": "companion"
  },
  "homepage": "https://github.com/ANPAN27/Amethyst/tree/main/companion",
  "bugs": {
    "url": "https://github.com/ANPAN27/Amethyst/issues"
  },
  "keywords": [
    "amethyst",
    "rea",
    "reverse-engineering",
    "companion",
    "cli"
  ],
  "files": [
    "dist",
    "README.md",
    "install.sh"
  ],
  "publishConfig": {
    "access": "public"
  }
}
