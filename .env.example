# ---------------------------------------------------------------------------
# Public (safe for the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin used for checkout return URLs. On Vercel, VERCEL_URL is used
# as a fallback when this is unset.
APP_URL=http://localhost:3000

# HMAC keys for pairing codes and companion bearer tokens. Generate with:
#   openssl rand -base64 48
PAIRING_CODE_SECRET=replace-with-32-plus-random-bytes
COMPANION_TOKEN_SECRET=replace-with-a-different-32-plus-random-bytes

# Private storage bucket name and artifact cap.
ARTIFACT_BUCKET=analysis-artifacts
MAX_ARTIFACT_BYTES=26214400

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# AI_PROVIDER: auto (default), openai, or gemini.
# auto treats a native generativelanguage.googleapis.com URL as Gemini and
# everything else as OpenAI-compatible.
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key

# OpenAI-compatible example:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
#
# Native Gemini example (AI_MODEL is required for a base URL; the server appends
# /models/<model>:generateContent). A full :generateContent URL also works and
# its model id is derived automatically.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_MODEL=gemini-2.5-flash
#
# Gemini's OpenAI-compatible endpoint also works; keep AI_PROVIDER=openai:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_EVIDENCE_CHARS=30000

# Credit cost per eligible operation (server-authoritative).
CREDITS_AI_CHAT=1
CREDITS_CODEGEN=5

# ---------------------------------------------------------------------------
# Dodo Payments
# ---------------------------------------------------------------------------
DODO_PAYMENTS_API_KEY=replace-with-dodo-api-key
DODO_PAYMENTS_WEBHOOK_KEY=replace-with-dodo-webhook-secret
DODO_ENVIRONMENT=test_mode

# Server-side product -> credit mapping. Clients only send a product id.
# The test-mode account currently uses 100, 500, and 1000 credit one-time packs.
# Replace these ids with the products from your own Dodo account.
DODO_PRODUCT_CREDITS={"pdt_replace_me_100":{"credits":100},"pdt_replace_me_500":{"credits":500},"pdt_replace_me_1000":{"credits":1000}}

# ---------------------------------------------------------------------------
# TigerGraph (optional; graph queries return 503 when unset)
# ---------------------------------------------------------------------------
TIGERGRAPH_URL=https://your-instance.tgcloud.io
TIGERGRAPH_GRAPH=Amethyst
TIGERGRAPH_TOKEN=replace-with-tigergraph-api-token
TIGERGRAPH_TIMEOUT_MS=10000
